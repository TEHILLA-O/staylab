# ---------------------------------------------------------------------------
# StayLab environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=staylab
POSTGRES_PASSWORD=staylab
POSTGRES_DB=staylab
POSTGRES_HOST=localhost
# Deliberately not 5432/5433 so the project never collides with a Postgres
# already running on the host.
POSTGRES_PORT=5434

# Full SQLAlchemy URL. Built from the parts above if left unset.
DATABASE_URL=postgresql+psycopg://staylab:staylab@localhost:5434/staylab

# --- Inside Airbnb source snapshot ---------------------------------------
INSIDE_AIRBNB_CITY=london
INSIDE_AIRBNB_SNAPSHOT=2026-06-19
INSIDE_AIRBNB_BASE_URL=https://data.insideairbnb.com/united-kingdom/england/london

# --- Experiment simulation ------------------------------------------------
# Fixed seed keeps the synthetic event stream fully reproducible.
EXPERIMENT_SEED=20260619
EXPERIMENT_SESSIONS=100000
EXPERIMENT_DAYS=14
EXPERIMENT_START_DATE=2026-06-19

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8010
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
